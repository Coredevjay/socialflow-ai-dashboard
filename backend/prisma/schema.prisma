generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  lastPasswordChange  DateTime             @default(now())
  role                String               @default("user")
  listings            Listing[]            @relation("MentorListings")
  passwordHistory     PasswordHistory[]
  refreshTokens       RefreshToken[]
  createdAt           DateTime             @default(now())
  deletedAt           DateTime?
  memberships         OrganizationMember[]
  roleAssignment      RoleAssignment?

  @@index([createdAt])
  @@index([deletedAt])
}

/// One row per active refresh session. Replaces the old
/// `User.refreshTokens String[]` column so that concurrent logins/refreshes
/// no longer clobber each other and sessions can be capped and pruned.
/// Only a SHA-256 hash of the token (or its jti) is persisted, never the raw
/// JWT. Tokens are grouped into families so that replay of an already-rotated
/// token can revoke the whole family.
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  jti         String
  familyId    String
  expiresAt   DateTime
  consumedAt  DateTime?
  rotatedAt   DateTime?
  revokedAt   DateTime?
  replacedBy  String?
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([userId, createdAt])
  @@index([familyId])
}

model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Durable RBAC role assignment — one row per user, persisted so that
// role checks are consistent across replicas and survive restarts/deploys.
model RoleAssignment {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id        String               @id @default(uuid())
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  deletedAt DateTime?
  members   OrganizationMember[]
  posts     Post[]
  analytics AnalyticsEntry[]
  listings  Listing[]

  @@index([createdAt])
  @@index([deletedAt])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("member")
  joinedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([joinedAt])
}

model Post {
  id                String       @id @default(uuid())
  organizationId    String
  content           String
  platform          PostPlatform
  scheduledAt       DateTime?
  moderationStatus  ModerationStatus @default("pending")
  mediaUrls         String[]     @default([])
  createdAt         DateTime     @default(now())
  deletedAt         DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([platform])
  @@index([createdAt])
  @@index([scheduledAt])
  @@index([moderationStatus])
  @@index([deletedAt])
}

model AnalyticsEntry {
  id             String       @id @default(uuid())
  organizationId String
  platform       String
  metric         String
  value          Float
  recordedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([platform])
  @@index([metric])
  @@index([recordedAt])
}

model DynamicConfig {
  key         String   @id
  value       String
  type        String   @default("string")
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String
  action         String
  organizationId String?
  resource       String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([resource, resourceId])
}

model AIGenerationResult {
  id             String   @id @default(uuid())
  jobId          String   @unique
  userId         String
  organizationId String?
  jobType        String
  output         Json
  traceId        String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([jobType])
  @@index([createdAt])
}

model Listing {
  id             String        @id @default(uuid())
  title          String
  description    String
  price          Decimal?  @db.Decimal(20, 7)
  isActive       Boolean       @default(true)
  mentorId       String
  mentor         User          @relation("MentorListings", fields: [mentorId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([mentorId])
  @@index([organizationId])
  @@index([isActive])
  @@index([createdAt])
  @@index([deletedAt])
}

model WebhookSubscription {
  id        String            @id @default(uuid())
  userId    String?
  url       String
  secret    String
  events    String[]
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  deliveries WebhookDelivery[]

  @@index([isActive])
  @@index([userId])
  @@index([deletedAt])
}

model WebhookDelivery {
  id             String              @id @default(uuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String
  payload        String
  status         WebhookDeliveryStatus              @default("pending")
  attempts       Int                 @default(0)
  nextRetryAt    DateTime?
  lastError      String?
  errorMessage   String?
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([subscriptionId])
  @@index([status, nextRetryAt])
  @@index([createdAt])
}

model TTSJob {
  id              String   @id
  status          TTSJobStatus   @default("pending")
  progress        Int      @default(0)
  request         Json
  outputAudioPath String?
  outputVideoPath String?
  segments        Json?
  error           String?
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

/// Audit record written whenever a payout job fails.
/// Captures the failure reason and timestamp for operational review.
model PayoutFailure {
  id          String   @id @default(uuid())
  jobId       String
  groupId     String
  recipient   String
  amount      Decimal  @db.Decimal(20, 7)
  currency    String
  reason      String
  failedAt    DateTime @default(now())

  @@index([jobId])
  @@index([groupId])
  @@index([failedAt])
}

/// Records Stellar transaction hashes before submission so retries
/// can detect duplicates and avoid paying a user twice.
model PayoutTransaction {
  id              String   @id @default(uuid())
  groupId         String
  recipient       String
  amount          Decimal  @db.Decimal(20, 7)
  currency        String
  transactionHash String   @unique
  jobId           String?
  status          PayoutStatus   @default("pending")
  createdAt       DateTime @default(now())
  confirmedAt     DateTime?

  @@index([groupId])
  @@index([recipient])
  @@index([jobId])
}

model Subscription {
  id                     String      @id @default(uuid())
  userId                 String      @unique
  plan                   SubscriptionPlan      @default("free")
  status                 SubscriptionStatus      @default("active")
  stripeCustomerId       String
  stripeSubscriptionId   String?
  creditsRemaining       Int
  creditsMonthly         Int
  currentPeriodEnd       DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  creditLogs             CreditLog[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model CreditLog {
  id             String       @id @default(uuid())
  userId         String
  action         String
  delta          Int
  balanceAfter   Int
  metadata       Json?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum PostPlatform {
  instagram
  tiktok
  facebook
  youtube
  linkedin
  twitter
  x
}

enum ModerationStatus {
  pending
  approved
  rejected
  flagged
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum TTSJobStatus {
  pending
  processing
  completed
  failed
}

enum PayoutStatus {
  pending
  submitted
  confirmed
  failed
}

enum SubscriptionPlan {
  free
  starter
  pro
  enterprise
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
}
